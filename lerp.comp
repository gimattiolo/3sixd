#version 450

// thee parameters need to match the value in teh setup code
#define num_cameras 6
#define height 1080
#define width 1920
#define channels 4
#define workgroup_size 32

layout (local_size_x = workgroup_size, local_size_y = workgroup_size, local_size_z = 1 ) in;

struct Pixel{
  vec4 value; // it's padded to vec4. no point at using vec3
};

struct Coordinate{
  ivec2 value;
};

layout(std140, binding = 0) readonly buffer AccumulationSSBOIn 
{
   Pixel  accumulation_normalization_buffer[];
};

layout(std140, binding = 1) readonly buffer ColorArraySSBOIn 
{
   Pixel  color_array_buffer[];
};

layout(std140, binding = 2) readonly buffer ConditionArraySSBOIn 
{
   Pixel  condition_array_buffer[];
};

layout(std140, binding = 3) readonly buffer PixelArraySSBOIn 
{
   Pixel  pixel_array_buffer[];
};

layout(std140, binding = 4) buffer PanoramaSBOOut
{
   Pixel panorama_buffer[];
};

void main() 
{
   /*
   In order to fit the work into workgroups, some unnecessary threads are launched.
   We terminate those threads here.
   */
   if(gl_GlobalInvocationID.x >= width || gl_GlobalInvocationID.y >= height)
   {
      return;
   }

   ivec2 pixel_coord2 = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
   vec4 zero4 = vec4(0.0);

   int output_index2 = width * pixel_coord2.y + pixel_coord2.x;

   vec4 accumulation_normalization = accumulation_normalization_buffer[output_index2].value;

   vec4 panorama = vec4(0.0, 0.0, 0.0, 1.0);

   //int pin_id=0;
   for(int pin_id=0; pin_id < num_cameras; ++pin_id)
   {
      int pixel_index3 = width * height * pin_id + width * pixel_coord2.y + pixel_coord2.x;

      vec4 pixel_value = pixel_array_buffer[pixel_index3].value;

      ivec2 color_coord2 = ivec2(pixel_value.x, pixel_value.y);

      int color_index3 = width * height * pin_id + width * color_coord2.y + color_coord2.x;
      //int color_index3 = pixel_index3;
      
      vec4 color = color_array_buffer[color_index3].value;

      vec4 condition = condition_array_buffer[pixel_index3].value;

      panorama += mix(zero4, color, condition); //panorama += mix(zero4, color, zero4);

      //panorama.rgb = color.rgb; 
      //panorama += mix(zero4, color, zero4);
      //panorama.rgb = color.rgb;
   }

   panorama.xyz *= accumulation_normalization.xyz;
   panorama_buffer[output_index2].value = panorama;
}