{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "calibration capture",
            "type": "debugpy",
            "request": "launch",
            "program": "~/gits/3sixd/cameraCalibrationCapture.py",
            "console": "integratedTerminal",
            "args": [
                "--path", "~/gits/3sixd/calibration_data_prototype",
                "--auto", "1",
                "--save_mode", "0",
                "--num_shots_per_capture", "20",
                "--capture_delta_time_sec", "1",
                //"--allowed_pins", "1", "3", "5",
                "--intrinsics_captures", "0", "1", "2", "3", "4", "5",
                "--extrinsics_captures", "0", "2", "4", "1", "3", "5", "0",
                "--flip_methods", "0", "2", "2", "2", "2", "2",
                "--pattern_size", "9", "6"
            ]
        },
        {
            "name": "simple camera",
            "type": "debugpy",
            "request": "launch",
            "program": "~/gits/3sixd/simple_camera.py",
            "console": "integratedTerminal",
            "args": [
            ]
        },
        {
            "name": "jetson camera",
            "type": "debugpy",
            "request": "launch",
            "program": "~/gits/3sixd/JetsonCamera.py",
            "console": "integratedTerminal",
            "args": [
            ]
        },
        {
            "name": "calibration",
            "type": "debugpy",
            "request": "launch",
            "program": "~/gits/3sixd/cameraCalibration.py",
            "console": "integratedTerminal",
            "args": [
                "--file_indices", "0", "1", "2", "3", "4", "5",
                // to make the pairs cyclical explicitely re-add first camera pin
                "--pairs", "0", "2", "4", "1", "3", "5", "0",
                "--intrinsic_path", "~/gits/3sixd/calibration_data_prototype",
                "--extrinsic_path", "~/gits/3sixd/calibration_data_prototype",
                "--output_path", "~/gits/3sixd/calibration_prototype",
                //"--use_intrinsics_guess",
                "--pattern_size", "9", "6",        
                "--pattern_side_length", "1",        
                "--intrinsic",
                "--extrinsic",
                //"--fisheye",
            ]
        },
        {
            "name": "calibration verification",
            "type": "debugpy",
            "request": "launch",
            "program": "~/gits/3sixd/cameraCalibrationVerify.py",
            "console": "integratedTerminal",
            "args": [
                "--input_paths", "~/gits/3sixd/calibration_data_prototype",
                "--output_path", "~/gits/3sixd/calibration_data_prototype",
                "--pattern_size", "9", "6",        
            ]
        },
        {
            "name": "panorama",
            "type": "debugpy",
            "request": "launch",
            "program": "~/gits/3sixd/panorama.py",
            "console": "integratedTerminal",
            "args": [
                //"--show_pin",
                "--path", "~/gits/3sixd/panorama_out",
                "--intrinsic_path", "~/gits/3sixd/calibration_data3",
                "--extrinsic_path", "~/gits/3sixd/calibration_data3",
                "--stream",
                //"--alpha", "1.046666667",
                //"--video_path", "/home/gimattiolo/gits/3sixd/output.mp4",
                // to make the pairs cyclical explicitely re-add first camera pin
                 "--pairs", "5", "0", "2", "4", "1", "3", "5",
                //"--pairs", "1", "3", "5",
                // "--pairs", "5", "0",
                  "--flip_methods", "2", "0", "2", "2", "2", "2", "2",
                //"--flip_methods", "2", "2", "2",
            ]
        },
        {
            "name": "optimize",
